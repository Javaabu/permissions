{
    "name": "javaabu/permissions",
    "description": "Roles, permissions and policies for Laravel apps and packages, built on spatie/laravel-permission",
    "homepage": "https://github.com/Javaabu/permissions",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "permissions",
        "roles",
        "rbac",
        "policies"
    ],
    "authors": [
        {
            "name": "Athfan Khaleel",
            "email": "athfan@javaabu.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0 || ^13.0",
        "spatie/laravel-permission": "^7.2",
        "javaabu/helpers": "^1.70",
        "javaabu/activitylog": "^1.5"
    },
    "require-dev": {
        "javaabu/boost-javaabu-guidelines": "^1.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.5.8"
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\Permissions\\": "src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\Permissions\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-clover build/coverage.xml",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-next-gen": "3.x-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\Permissions\\PermissionsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
